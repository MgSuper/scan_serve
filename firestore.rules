rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Authentication custom claims are issued by trusted backend code. Staff claims
    // contain restaurantId, role, permissions, and isActive. Customer claims contain
    // restaurantId and customerSessionId for the active dining session.

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRestaurantClaim() {
      return isAuthenticated()
        && request.auth.token.restaurantId is string;
    }

    function belongsToRestaurant(restaurantId) {
      return hasRestaurantClaim()
        && restaurantId is string
        && request.auth.token.restaurantId == restaurantId;
    }

    function isActiveStaff() {
      return isAuthenticated()
        && request.auth.token.accountType == 'staff'
        && request.auth.token.isActive == true;
    }

    function hasRole(role) {
      return isActiveStaff()
        && request.auth.token.role is string
        && request.auth.token.role == role;
    }

    function hasPermission(permission) {
      return isActiveStaff()
        && request.auth.token.permissions is list
        && permission in request.auth.token.permissions;
    }

    function isRestaurantManager() {
      return isActiveStaff()
        && (
          hasRole('Manager')
          || hasRole('Restaurant Manager')
          || hasPermission('restaurant.manage')
        );
    }

    function isKitchenStaff() {
      return isActiveStaff()
        && (
          hasRole('Kitchen')
          || hasRole('Kitchen Staff')
          || hasPermission('orders.updateStatus')
        );
    }

    function isRestaurantStaff() {
      return isActiveStaff()
        && (
          hasRole('Manager')
          || hasRole('Restaurant Manager')
          || hasRole('Waiter')
          || hasRole('Kitchen')
          || hasRole('Kitchen Staff')
          || hasPermission('orders.read')
        );
    }

    function isStaffForRestaurant(restaurantId) {
      return isRestaurantStaff()
        && belongsToRestaurant(restaurantId);
    }

    function isManagerForRestaurant(restaurantId) {
      return isRestaurantManager()
        && belongsToRestaurant(restaurantId);
    }

    function isKitchenStaffForRestaurant(restaurantId) {
      return isKitchenStaff()
        && belongsToRestaurant(restaurantId);
    }

    function hasCustomerSessionClaim() {
      return isAuthenticated()
        && request.auth.token.customerSessionId is string;
    }

    function isCustomerSessionOwner(customerSessionId) {
      return hasCustomerSessionClaim()
        && customerSessionId is string
        && request.auth.token.customerSessionId == customerSessionId;
    }

    // Own-resource access is bound to a server-issued customerSessionId claim.
    // This prevents a caller from treating a guessed document ID as ownership.
    function isResourceOwner() {
      return hasCustomerSessionClaim()
        && (
          (
            resource.data.customerSessionId is string
            && isCustomerSessionOwner(resource.data.customerSessionId)
          )
          || resource.id == request.auth.token.customerSessionId
        );
    }

    function isNewResourceOwner() {
      return hasCustomerSessionClaim()
        && (
          (
            request.resource.data.customerSessionId is string
            && isCustomerSessionOwner(request.resource.data.customerSessionId)
          )
          || request.resource.id == request.auth.token.customerSessionId
        );
    }

    function isActiveCustomerSession(customerSessionId) {
      return isCustomerSessionOwner(customerSessionId)
        && exists(/databases/$(database)/documents/customerSessions/$(customerSessionId))
        && get(/databases/$(database)/documents/customerSessions/$(customerSessionId)).data.restaurantId == request.auth.token.restaurantId
        && get(/databases/$(database)/documents/customerSessions/$(customerSessionId)).data.status == 'ACTIVE';
    }

    function isCustomerOrderOwner(orderId) {
      return hasCustomerSessionClaim()
        && exists(/databases/$(database)/documents/orders/$(orderId))
        && isCustomerSessionOwner(
          get(/databases/$(database)/documents/orders/$(orderId)).data.customerSessionId
        )
        && belongsToRestaurant(
          get(/databases/$(database)/documents/orders/$(orderId)).data.restaurantId
        );
    }

    function isOrderTenant(orderId, restaurantId) {
      return exists(/databases/$(database)/documents/orders/$(orderId))
        && get(/databases/$(database)/documents/orders/$(orderId)).data.restaurantId == restaurantId;
    }

    function keepsTenant(resourceRestaurantId, requestedRestaurantId) {
      return resourceRestaurantId == requestedRestaurantId
        && belongsToRestaurant(requestedRestaurantId);
    }

    function hasOnlyOrderStatusChanges() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'updatedAt',
        'acceptedAt',
        'preparedAt',
        'servedAt'
      ]);
    }

    match /restaurants/{restaurantId} {
      // Only public business information should be stored in documents readable here.
      allow read: if resource.data.isActive == true;
      allow create, update, delete: if false;
    }

    match /branches/{branchId} {
      allow read: if resource.data.isActive == true;
      allow create: if isManagerForRestaurant(request.resource.data.restaurantId);
      allow update: if isManagerForRestaurant(resource.data.restaurantId)
        && keepsTenant(resource.data.restaurantId, request.resource.data.restaurantId)
        && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    match /tables/{tableId} {
      allow read: if resource.data.isActive == true;
      allow create: if isManagerForRestaurant(request.resource.data.restaurantId);
      allow update: if isManagerForRestaurant(resource.data.restaurantId)
        && keepsTenant(resource.data.restaurantId, request.resource.data.restaurantId)
        && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    match /tableSessions/{tableSessionId} {
      allow read: if (
        resource.data.isActive == true
        && hasCustomerSessionClaim()
        && request.auth.token.tableSessionId == resource.id
      ) || isStaffForRestaurant(resource.data.restaurantId);
      // Starting a dining session is a trusted CF-001 operation.
      allow create, update, delete: if false;
    }

    match /customerSessions/{customerSessionId} {
      allow read: if isResourceOwner()
        || isStaffForRestaurant(resource.data.restaurantId);

      allow create: if isNewResourceOwner()
        && belongsToRestaurant(request.resource.data.restaurantId)
        && request.resource.data.id == request.resource.id
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.isArchived == false;

      allow update: if isResourceOwner()
        && isActiveCustomerSession(resource.id)
        && keepsTenant(resource.data.restaurantId, request.resource.data.restaurantId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'languageCode',
          'deviceId',
          'lastActivityAt',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    match /carts/{cartId} {
      allow read: if isResourceOwner()
        && isActiveCustomerSession(resource.data.customerSessionId);

      allow create: if isNewResourceOwner()
        && request.resource.data.id == request.resource.id
        && request.resource.data.customerSessionId == request.auth.token.customerSessionId
        && isActiveCustomerSession(request.resource.data.customerSessionId)
        && belongsToRestaurant(request.resource.data.restaurantId)
        && request.resource.data.isArchived == false;

      allow update: if isResourceOwner()
        && isActiveCustomerSession(resource.data.customerSessionId)
        && keepsTenant(resource.data.restaurantId, request.resource.data.restaurantId)
        && request.resource.data.customerSessionId == resource.data.customerSessionId
        && request.resource.data.id == resource.data.id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'items',
          'updatedAt'
        ]);

      // CF-002 clears the cart after creating the order.
      allow delete: if false;
    }

    match /menus/{menuId} {
      allow read: if resource.data.isActive == true
        || isStaffForRestaurant(resource.data.restaurantId);
      allow create: if isManagerForRestaurant(request.resource.data.restaurantId);
      allow update: if isManagerForRestaurant(resource.data.restaurantId)
        && keepsTenant(resource.data.restaurantId, request.resource.data.restaurantId)
        && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if resource.data.isActive == true
        || isStaffForRestaurant(resource.data.restaurantId);
      allow create: if isManagerForRestaurant(request.resource.data.restaurantId);
      allow update: if isManagerForRestaurant(resource.data.restaurantId)
        && keepsTenant(resource.data.restaurantId, request.resource.data.restaurantId)
        && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    match /menuItems/{menuItemId} {
      allow read: if (
        resource.data.isActive == true
        && resource.data.isAvailable == true
      ) || isStaffForRestaurant(resource.data.restaurantId);
      allow create: if isManagerForRestaurant(request.resource.data.restaurantId);
      allow update: if isManagerForRestaurant(resource.data.restaurantId)
        && keepsTenant(resource.data.restaurantId, request.resource.data.restaurantId)
        && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow read: if (
        isResourceOwner()
        && belongsToRestaurant(resource.data.restaurantId)
      ) || isStaffForRestaurant(resource.data.restaurantId);

      // Order creation is exclusively CF-002 / trusted backend authority.
      allow create: if false;

      allow update: if (
        isKitchenStaffForRestaurant(resource.data.restaurantId)
        && keepsTenant(resource.data.restaurantId, request.resource.data.restaurantId)
        && hasOnlyOrderStatusChanges()
        && request.resource.data.id == resource.data.id
      ) || (
        isManagerForRestaurant(resource.data.restaurantId)
        && keepsTenant(resource.data.restaurantId, request.resource.data.restaurantId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'customerNote',
          'updatedAt',
          'acceptedAt',
          'preparedAt',
          'servedAt'
        ])
      );

      allow delete: if false;
    }

    match /orderItems/{orderItemId} {
      allow read: if (
        isCustomerOrderOwner(resource.data.orderId)
        && isOrderTenant(resource.data.orderId, resource.data.restaurantId)
      ) || isStaffForRestaurant(resource.data.restaurantId);

      // Order items are created and maintained transactionally by CF-002.
      allow create, update, delete: if false;
    }

    match /staff/{staffId} {
      allow read: if isStaffForRestaurant(resource.data.restaurantId);

      allow create: if isManagerForRestaurant(request.resource.data.restaurantId)
        && request.resource.data.id == request.resource.id
        && request.resource.data.isActive == true;

      allow update: if isManagerForRestaurant(resource.data.restaurantId)
        && keepsTenant(resource.data.restaurantId, request.resource.data.restaurantId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.authUid == resource.data.authUid;

      allow delete: if false;
    }

    match /roles/{roleId} {
      allow read: if isStaffForRestaurant(resource.data.restaurantId);
      allow create: if isManagerForRestaurant(request.resource.data.restaurantId)
        && request.resource.data.id == request.resource.id;
      allow update: if isManagerForRestaurant(resource.data.restaurantId)
        && keepsTenant(resource.data.restaurantId, request.resource.data.restaurantId)
        && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }
  }
}
