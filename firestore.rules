rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Customers may browse menu data; authenticated staff may manage it.
    match /restaurants/{restaurantId}/menu/{menuItemId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Customer order creation remains available to the ordering flow. Reads and
    // subsequent mutations are restricted to authenticated staff sessions.
    match /restaurants/{restaurantId}/orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // Other restaurant-scoped operational documents are staff-only.
    match /restaurants/{restaurantId}/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Backend status updates and legacy dashboard reads use the top-level orders path.
    match /orders/{orderId} {
      allow read, write: if isAuthenticated();
    }

    // Preserve public catalog reads for any legacy top-level catalog collections.
    match /menus/{menuId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /menuItems/{menuItemId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /staff/{staffId} {
      allow read, write: if isAuthenticated();
    }

    match /roles/{roleId} {
      allow read, write: if isAuthenticated();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
